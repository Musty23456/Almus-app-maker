# Copy to .env (never commit .env) or set these as environment variables / platform secrets.
# ---- required ----
# Your Gemini API key from Google AI Studio. Lives ONLY here, never in the Android app.
GEMINI_API_KEY=
# At least 32 random characters. Signs the short-lived tokens the app receives. Generate: openssl rand -hex 32
ALMUS_TOKEN_SECRET=
# Who may use this backend. name=code pairs separated by commas. Use a long random code per person/device.
# Stored codes may be plain or hashed:  alice=sha256:<hex of sha256(code)>   (node scripts/hash-code.js <code>)
ALMUS_ACCESS_CODES=

# ---- optional ----
PORT=8080
HOST=0.0.0.0
# Models the app may choose from (comma separated) and the default. Check Google's current model list and set these.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2
TOKEN_TTL_SECONDS=3600
# Requests per user per minute and per day
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=600
# Request size limits
MAX_BODY_BYTES=1500000
MAX_PROMPT_CHARS=400000
# Set to 1 only when running behind a reverse proxy you control (Render, Cloud Run, nginx...) so client IPs are read from X-Forwarded-For
TRUST_PROXY=0
