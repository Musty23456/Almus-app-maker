# Gradle
.gradle/
/build/
/*/build/
# Source packages that are named "build" (domain/build, service/build) must never be ignored
!app/src/**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/
.externalNativeBuild/
.cxx/

# OS files
.DS_Store
Thumbs.db

# Secrets and signing material - NEVER commit these
*.jks
*.keystore
keystore.properties
secrets.properties
.env

# Phase 9: the backend holds the Gemini key in .env - never commit it
backend/.env
backend/.env.*
!backend/.env.example
backend/node_modules/
